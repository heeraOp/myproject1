DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_CSRF_COOKIE_SAMESITE=None
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_ENFORCE_HTTPS=True
DJANGO_FORCE_SECURE_COOKIES=True
DJANGO_ENABLE_HSTS=True
DJANGO_USE_POSTGRES=True
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
UVICORN_WORKERS=3
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2
NGINX_PORT=80
